# Version authored Pi configuration only, not the managed runtime or local state.
.pi/agent/*
!.pi/agent/settings.json
!.pi/agent/keybindings.json
!.pi/agent/agents/
!.pi/agent/extensions/
!.pi/agent/skills/
!.pi/agent/prompts/
!.pi/agent/bin/
.pi/agent/bin/*
!.pi/agent/bin/pi-skills

# Keep installed dependencies and local browser state out of Git.
**/node_modules
**/.cache/
**/auth.json
**/credentials.json
**/.env
**/.env.*
**/screenshots/
**/downloads/
**/browser-profile/
