# Ported from alacritty/.config/alacritty/alacritty.toml.
# Install the licensed Comic Code fonts privately; Ghostty falls back if absent.
font-family = ComicCodeLigatures Nerd Font
font-size = 22

# Alacritty's default colors were implicit in the old config.
# Pin them here instead of inheriting Ghostty's different defaults.
background = 181818
foreground = d8d8d8
palette = 0=#181818
palette = 1=#ac4242
palette = 2=#90a959
palette = 3=#f4bf75
palette = 4=#6a9fb5
palette = 5=#aa759f
palette = 6=#75b5aa
palette = 7=#d8d8d8
palette = 8=#6b6b6b
palette = 9=#c55555
palette = 10=#aac474
palette = 11=#feca88
palette = 12=#82b8c8
palette = 13=#c28cb8
palette = 14=#93d3c3
palette = 15=#f8f8f8

# Both Option keys act as Alt for shell/tmux applications.
macos-option-as-alt = true

# Closest buttonless-window equivalent; keep native window decorations.
macos-window-buttons = hidden
maximize = true

# Preserve the explicit byte sequences from the Alacritty config.
keybind = ctrl+q=text:\x11
keybind = alt+h=esc:h
keybind = alt+j=esc:j
keybind = alt+k=esc:k
keybind = alt+l=esc:l
keybind = super+alt+space=text:\xc2\xa0

# Ligatures use Ghostty's defaults. No automatic tmux startup, tabs or splits.
